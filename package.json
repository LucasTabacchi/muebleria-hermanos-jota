{
    "name": "muebleria-hermanos-jota",
    "version": "1.0.0",
    "private": true,
    "description": "Ecommerce full stack de Mueblería Hermanos Jota.",
    "workspaces": [
        "client",
        "backend"
    ],
    "scripts": {
        "dev": "concurrently --kill-others --names backend,client --prefix-colors blue,magenta \"npm run dev:backend\" \"npm run dev:client\"",
        "dev:client": "npm start --workspace=client",
        "dev:backend": "npm run dev --workspace=backend",
        "start:client": "npm start --workspace=client",
        "start:backend": "npm start --workspace=backend",
        "lint": "eslint \"**/*.{js,jsx,cjs,mjs}\"",
        "format": "prettier --write .",
        "test": "npm run test:backend && npm run test:client",
        "test:backend": "npm test --workspace=backend",
        "test:client": "npm test --workspace=client -- --watchAll=false",
        "build": "npm run build --workspace=client",
        "prepare": "husky"
    },
    "engines": {
        "node": ">=22.22.1"
    },
    "lint-staged": {
        "*.{js,jsx,cjs,mjs}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@eslint/js": "8.57.1",
        "concurrently": "10.0.5",
        "eslint": "8.57.1",
        "eslint-plugin-react": "7.37.5",
        "globals": "17.12.0",
        "husky": "9.1.7",
        "lint-staged": "17.5.0",
        "prettier": "3.9.6",
        "typescript": "5.9.3"
    }
}
