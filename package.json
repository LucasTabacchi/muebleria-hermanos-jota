{
    "name": "muebleria-hermanos-jota",
    "version": "1.0.0",
    "private": true,
    "description": "Ecommerce frontend de Mueblería Hermanos Jota.",
    "scripts": {
        "lint": "eslint \"**/*.{js,cjs,mjs}\"",
        "format": "prettier --write .",
        "test": "node --test tests/productos.test.cjs",
        "prepare": "husky"
    },
    "engines": {
        "node": ">=22.22.1"
    },
    "lint-staged": {
        "*.{js,jsx,cjs,mjs}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@eslint/js": "10.0.1",
        "eslint": "10.10.0",
        "globals": "17.12.0",
        "husky": "9.1.7",
        "lint-staged": "17.5.0",
        "prettier": "3.9.6"
    }
}
